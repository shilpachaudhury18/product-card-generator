# copy to .env and fill in - never commit the real .env

# get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-flash-latest
# tried in order when the main model is overloaded or unavailable
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite

PORT=5001
# comma-separated list of frontend urls allowed to call the api
CORS_ORIGIN=http://localhost:5173
# generate requests per minute, per ip
RATE_LIMIT_MAX=10

NODE_ENV=development
